            <column caption='Churned Customers' datatype='integer' name='[Calculation_2317946497660362753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [ActiveSubscriptions] = 0&#13;&#10;       AND [TotalSubscriptions] &gt; 0&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
