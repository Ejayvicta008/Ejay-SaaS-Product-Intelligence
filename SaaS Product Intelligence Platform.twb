      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_Organization_360 (semantic.vw_Organization_360) (Ejay_SaaS_Product_Intelligence)' name='federated.0h803ur0qoetjv146p2wc0w6v55o' />
          </datasources>
          <datasource-dependencies datasource='federated.0h803ur0qoetjv146p2wc0w6v55o'>
            <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_2317946497944297478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [CustomerRetentionStatus] = &apos;Retained&apos;&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [CustomerRetentionStatus] IN (&apos;Retained&apos;, &apos;Churned&apos;)&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2317946497945038855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [IsChurned] = 1&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [TotalSubscriptions] &gt; 0&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption=' Country' datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
