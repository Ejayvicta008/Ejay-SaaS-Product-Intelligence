            <column caption='Is Churned' datatype='integer' name='[IsChurned]' role='measure' type='quantitative' />
            <column caption='Latest Invoice Date' datatype='date' name='[LatestInvoiceDate]' role='dimension' type='ordinal' />
            <column caption='Latest Payment Date' datatype='date' name='[LatestPaymentDate]' role='dimension' type='ordinal' />
            <column caption='Total Subscriptions' datatype='integer' name='[TotalSubscriptions]' role='measure' type='quantitative' />
            <column caption='Acquisition Channel' datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Industry]' derivation='None' name='[none:Industry:nk]' pivot='key' type='nominal' />
            <column-instance column='[LatestInvoiceDate]' derivation='None' name='[none:LatestInvoiceDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[LatestPaymentDate]' derivation='None' name='[none:LatestPaymentDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[acquisition_channel]' derivation='None' name='[none:acquisition_channel:nk]' pivot='key' type='nominal' />
