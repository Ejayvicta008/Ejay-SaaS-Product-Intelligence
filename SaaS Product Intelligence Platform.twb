      <column caption='Active Subscriptions' datatype='integer' name='[ActiveSubscriptions]' role='measure' type='quantitative' />
      <column caption='ActiveUsers (vw Product Engagement)' datatype='integer' name='[ActiveUsers (vw_Product_Engagement)]' role='measure' type='quantitative' />
      <column caption='Active Users' datatype='integer' name='[ActiveUsers]' role='measure' type='quantitative' />
      <column caption='Activity Status' datatype='string' name='[ActivityStatus]' role='dimension' type='nominal' />
      <column caption='Alerts Fired' datatype='integer' name='[AlertsFired]' role='measure' type='quantitative' />
      <column caption='Anonymous Usage Events' datatype='integer' name='[AnonymousUsageEvents]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([acquisition_channel (vw_Customer_Retention)]) / TOTAL(COUNT([acquisition_channel (vw_Customer_Retention)]))'>
          <table-calc ordering-field='[federated.0h803ur0qoetjv146p2wc0w6v55o].[none:acquisition_channel (vw_Customer_Retention):nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='VARP([EstimatedARR]) / TOTAL(VARP([EstimatedARR]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_2317946497659506688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [ActiveSubscriptions] &gt; 0&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_2317946497660362753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [ActiveSubscriptions] = 0&#13;&#10;       AND [TotalSubscriptions] &gt; 0&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='User Adoption Rate %' datatype='real' datatype-customized='true' default-format='p0.00%' name='[Calculation_2317946497740648452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[UserAdoptionRatePct] / 100' />
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_2317946497944297478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [CustomerRetentionStatus] = &apos;Retained&apos;&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [CustomerRetentionStatus] IN (&apos;Retained&apos;, &apos;Churned&apos;)&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2317946497945038855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [IsChurned] = 1&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [TotalSubscriptions] &gt; 0&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Retained Customers' datatype='integer' name='[Calculation_2317946497945690120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [CustomerRetentionStatus] = &apos;Retained&apos;&#13;&#10;    THEN [organization_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Donut Placeholder' datatype='integer' name='[Calculation_2317946497947254794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Customer Lifetime (Days)' datatype='integer' name='[Calculation_2317946497951313932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [TotalSubscriptions] = 0 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [signed_up_on], TODAY())&#13;&#10;&#13;&#10;ELSEIF [ActiveSubscriptions] &gt; 0 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [signed_up_on], TODAY())&#13;&#10;&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [signed_up_on],&#13;&#10;        DATE([LastSubscriptionEndDate])&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Average Customer Tenure (Months)' datatype='real' name='[Calculation_2317946497957281806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_2317946497951313932]) / 30.4375' />
      </column>
      <column caption='CancelledSubscriptions (vw Customer Retention)' datatype='integer' name='[CancelledSubscriptions (vw_Customer_Retention)]' role='measure' type='quantitative' />
      <column caption='Cancelled Subscriptions' datatype='integer' name='[CancelledSubscriptions]' role='measure' type='quantitative' />
