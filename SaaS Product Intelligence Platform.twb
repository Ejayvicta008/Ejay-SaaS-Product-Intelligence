    <worksheet name='CR - Customer Tenure'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Average Tenure</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_Organization_360 (semantic.vw_Organization_360) (Ejay_SaaS_Product_Intelligence)' name='federated.0h803ur0qoetjv146p2wc0w6v55o' />
          </datasources>
          <datasource-dependencies datasource='federated.0h803ur0qoetjv146p2wc0w6v55o'>
            <column caption='Active Subscriptions' datatype='integer' name='[ActiveSubscriptions]' role='measure' type='quantitative' />
            <column caption='Customer Lifetime (Days)' datatype='integer' name='[Calculation_2317946497951313932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [TotalSubscriptions] = 0 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [signed_up_on], TODAY())&#13;&#10;&#13;&#10;ELSEIF [ActiveSubscriptions] &gt; 0 THEN&#13;&#10;    DATEDIFF(&apos;day&apos;, [signed_up_on], TODAY())&#13;&#10;&#13;&#10;ELSE&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [signed_up_on],&#13;&#10;        DATE([LastSubscriptionEndDate])&#13;&#10;    )&#13;&#10;END' />
            </column>
            <column caption='Average Customer Tenure (Months)' datatype='real' name='[Calculation_2317946497957281806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2317946497951313932]) / 30.4375' />
            </column>
            <column datatype='date' name='[FirstSubscriptionDate]' role='dimension' type='ordinal' />
            <column datatype='date' name='[LastSubscriptionEndDate]' role='dimension' type='ordinal' />
            <column caption='Total Subscriptions' datatype='integer' name='[TotalSubscriptions]' role='measure' type='quantitative' />
            <column-instance column='[FirstSubscriptionDate]' derivation='Month' name='[mn:FirstSubscriptionDate:ok]' pivot='key' type='ordinal' />
            <column caption='Signed Up On' datatype='date' name='[signed_up_on]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2317946497957281806]' derivation='User' name='[usr:Calculation_2317946497957281806:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0h803ur0qoetjv146p2wc0w6v55o].[usr:Calculation_2317946497957281806:qk]' field-type='quantitative' max='25.0' min='16.0' range-type='fixed' scope='rows' type='space' />
            <format attr='display' class='0' field='[federated.0h803ur0qoetjv146p2wc0w6v55o].[usr:Calculation_2317946497957281806:qk]' scope='rows' value='false' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0h803ur0qoetjv146p2wc0w6v55o].[usr:Calculation_2317946497957281806:qk]' value='n#,##0.00;-#,##0.00' />
          </style-rule>
