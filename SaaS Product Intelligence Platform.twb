        <viewpoint name='RA - Total Paid Amount'>
          <zoom type='entire-view' />
          <selection-collection>
            <tuple-selection>
              <tuple-reference>
                <tuple-descriptor>
                  <pane-descriptor>
                    <x-fields />
                    <y-fields />
                  </pane-descriptor>
                  <columns>
                    <field>[federated.0h803ur0qoetjv146p2wc0w6v55o].[sum:TotalPaidAmount:qk]</field>
                  </columns>
